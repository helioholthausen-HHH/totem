#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    macros {
        del_line_left: del_line_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings = <&kp LS(HOME) &kp BACKSPACE>;
        };

        alt_tab_hold: alt_tab_hold {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <40>;
            tap-ms = <40>;
            bindings
                = <&macro_press &kp LALT>
                , <&macro_tap &kp TAB>
                , <&macro_pause_for_release>
                , <&macro_release &kp LALT>
                ;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "base";
            bindings = <
&kp Q      &kp W  &kp E  &kp R      &kp T            &kp Y          &kp U  &kp I  &kp O      &kp P
&kp A      &kp S  &kp D  &kp F      &kp G            &kp H          &kp J  &kp K  &kp L      &kp SEMI
&kp LCTRL  &kp Z  &kp X  &kp C      &kp V            &kp B          &kp N  &kp M  &kp COMMA  &kp DOT   &kp FSLH  &kp APOS
&kp LGUI   &mo 2  &mo 1  &kp SPACE  &kp RIGHT_SHIFT  &lt 4 RIGHT_ALT
            >;
        };

        nav_num {
            display-name = "nav_num";
            bindings = <
&kp LC(BACKSPACE)   &kp BACKSPACE  &kp UP    &kp DELETE  &kp LC(DELETE)  &kp N5       &kp N6      &kp N7    &kp N8     &kp N9
&kp LC(LEFT_ARROW)  &kp LEFT       &kp DOWN  &kp RIGHT   &kp LC(RIGHT)   &kp N0       &kp N1      &kp N2    &kp N3     &kp N4
&del_line_left       &kp LC(HOME)   &kp HOME  &kp ENTER   &kp END         &kp LC(END)  &kp PERIOD  &kp PLUS  &kp MINUS  &kp STAR  &kp FSLH  &kp CARET
&trans               &trans         &trans    &kp EQUAL   &kp RIGHT_SHIFT &kp PERCENT
            >;
        };

        sym_func {
            display-name = "sym_func";
            bindings = <
&kp ESC    &kp LS(RBKT)    &kp LS(BSLH)          &kp LBKT              &caps_word        &kp F1          &kp F2   &kp F3   &kp F4   &kp F5
&kp TAB    &kp RBKT        &kp BSLH              &kp ENTER              &kp NON_US_BSLH   &kp F6          &kp F7   &kp F8   &kp F9   &kp F10
&kp GRAVE  &kp LESS_THAN   &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp GREATER_THAN  &kp UNDERSCORE  &kp F11  &kp F12  &kp F13  &kp F14  &kp F15  &kp F16
&trans     &trans          &trans                &none                  &kp RIGHT_SHIFT   &none
            >;
        };

        device {
            display-name = "device";
            bindings = <
&none       &kp C_BRIGHTNESS_DEC  &kp C_BRIGHTNESS_INC  &none             &none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&kp K_MUTE  &kp C_VOLUME_DOWN     &kp C_VOLUME_UP       &kp C_PLAY_PAUSE  &none  &none         &none         &none         &none         &none
&none       &none                 &none                 &none             &none  &none         &none         &none         &none         &none         &none  &bt BT_CLR
&none       &none                 &none                 &none             &none  &none
            >;
        };

        alt_r {
            display-name = "ALT_R";
            bindings = <
&trans       &trans  &trans  &trans  &trans      &trans  &kp LS(N2)  &kp LS(N7)  &trans       &trans
&alt_tab_hold &kp TAB &kp LS(TAB) &trans &trans      &trans  &kp LS(N1)  &kp RA(W)   &trans       &trans
&trans       &trans  &trans  &trans  &trans      &trans  &trans      &kp RA(Q)   &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &trans
&trans       &trans  &trans  &kp LA(SPACE)  &trans  &trans
            >;
        };

        extra2 {
            display-name = "extra2";
            status = "reserved";
        };

        extra3 {
            display-name = "extra3";
            status = "reserved";
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        device {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };
};
